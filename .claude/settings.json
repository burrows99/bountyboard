{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install alexander hook pre-tool --agent claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install alexander hook post-tool --agent claude"
          }
        ]
      }
    ]
  }
}
